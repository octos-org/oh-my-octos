<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.matrix.synapse</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOU/octos-matrix/venv/bin/python</string>
		<string>-m</string>
		<string>synapse.app.homeserver</string>
		<string>--config-path</string>
		<string>/Users/YOU/octos-matrix/homeserver.yaml</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/YOU/octos-matrix/venv/bin:/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>/Users/YOU/octos-matrix</string>
	<key>StandardOutPath</key>
	<string>/Users/YOU/octos-matrix/synapse.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOU/octos-matrix/synapse.err.log</string>
</dict>
</plist>
